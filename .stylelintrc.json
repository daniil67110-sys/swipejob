{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "color-hex-length": "short",
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "import",
          "tailwind",
          "apply",
          "layer",
          "config",
          "theme",
          "variants",
          "responsive",
          "screen",
          "plugin",
          "source",
          "utility",
          "custom-variant"
        ]
      }
    ],
    "selector-class-pattern": null,
    "no-descending-specificity": null
  },
  "ignoreFiles": ["**/node_modules/**", "**/.next/**", "**/dist/**", "**/build/**"]
}
