# ============================================================
# SwipeJob — Variables d'environnement (exemple)
# Copier ce fichier en .env.local et remplir les valeurs réelles
# NE PAS committer .env.local dans le dépôt
# ============================================================

# ------------------------------------------------------------
# Database & Cache (Story 1.2+)
# ------------------------------------------------------------
# DATABASE_URL : Neon Postgres EU 16+ avec extensions citext + pgvector activées.
# Format Neon : postgres://user:pass@xxx.eu-west-1.aws.neon.tech/swipejob?sslmode=require
# Format local : postgres://danii:pass@localhost:5432/swipejob
# DATABASE_URL=postgres://...

# REDIS_URL=redis://...          # Upstash Redis EU (Story 1.2 — TECH-005)

# ------------------------------------------------------------
# LLM Providers (Story 2.8 — TECH-004)
# ------------------------------------------------------------
# MISTRAL_API_KEY=...            # Mistral La Plateforme — primaire
# ANTHROPIC_API_KEY=...          # Anthropic Claude EU — fallback

# ------------------------------------------------------------
# Auth & URLs
# ------------------------------------------------------------
SITE_URL=http://localhost:3000      # URL publique app (metadataBase, SEO, OpenGraph)
# NEXTAUTH_SECRET=...            # Auth.js v5 (Story 1.3 — TECH-003)
# NEXTAUTH_URL=http://localhost:3000  # URL Auth.js (callback URLs OAuth)

# ------------------------------------------------------------
# Email (Story 1.4)
# ------------------------------------------------------------
# RESEND_API_KEY=...             # Resend EU SES

# ------------------------------------------------------------
# Cloudflare R2 — CV/docs storage (Story 1.6 — TECH-007)
# ------------------------------------------------------------
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=swipejob-dev

# ============================================================
# OBSERVABILITY — Story 1.2 (TECH-006 + TECH-009)
# ============================================================
# Toutes les variables ci-dessous sont optionnelles : le code skip silencieusement
# si elles sont absentes (logs warn en dev). Boot OK sans aucune credential.

# ----- Sentry (errors + tracing) -----
# Dashboard: https://sentry.io/settings/<org>/projects/<project>/keys/
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>     # serveur (Node) — apps/web SSR + apps/worker
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>  # client (browser)
# SENTRY_AUTH_TOKEN=...          # Auth token org-level pour upload source maps (CI build)
# SENTRY_ORG=swipejob            # slug de l'org Sentry
# SENTRY_PROJECT=swipejob-web    # slug du projet
# NEXT_PUBLIC_APP_VERSION=0.1.0  # version exposée par /api/health (sinon "dev")

# ----- Posthog Cloud EU (analytics produit) -----
# Dashboard: https://eu.i.posthog.com/project/<id>/settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_...      # Project API key (client + serveur)
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com  # EU obligatoire RGPD
# POSTHOG_API_KEY=phx_...              # Personal API key pour ingestion serveur (optionnel)
# POSTHOG_DISTINCT_ID_SALT=...         # Salt HMAC-SHA256 hash userId (≥32 chars en prod, ≥16 en dev, différent par env)

# ----- PII hashing -----
# PII_EMAIL_HASH_SECRET=...            # Secret HMAC-SHA256 hash emails (≥16 chars en prod). Requis si prod.

# ----- Axiom (logs structurés Pino JSON) -----
# Dashboard: https://app.axiom.co/settings/api-tokens
# AXIOM_TOKEN=xaat-...                 # API token avec ingest sur les 3 datasets
# AXIOM_DATASET_WEB=swipejob-web       # dataset apps/web (rétention 30j)
# AXIOM_DATASET_WORKER=swipejob-worker # dataset apps/worker (rétention 30j)
# AXIOM_DATASET_AUDIT=swipejob-audit   # dataset audit RGPD/IA Act (rétention 13 mois NFR-O5)

# ============================================================
# WORKER — Story 1.2
# ============================================================
WORKER_PORT=4000               # Port HTTP du worker Hono (défaut : 4000)
LOG_LEVEL=info                 # Niveau Pino : trace|debug|info|warn|error|fatal|silent
WORKER_ROLE=all                # all | http-only | jobs-only (pour split runtime CI/dev)

# ----- Audit export mensuel R2 (Task 9) -----
AUDIT_EXPORT_ENABLED=false     # true → upload réel R2 ; false → dry-run (log + skip)
# R2_AUDIT_BUCKET=swipejob-audit-archive       # bucket dédié avec object lock COMPLIANCE 13 mois
# R2_AUDIT_ACCESS_KEY_ID=...                   # IAM key audit-admin
# R2_AUDIT_SECRET_ACCESS_KEY=...
# R2_AUDIT_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ============================================================
# CI / DEPLOYMENT (Story 1.2)
# ============================================================
# CI=true                       # injecté automatiquement par GitHub Actions
# VERCEL_ENV=production         # injecté par Vercel (development|preview|production)
# VERCEL_GIT_COMMIT_SHA=...     # injecté par Vercel build
# RAILWAY_GIT_COMMIT_SHA=...    # injecté par Railway deploy worker
