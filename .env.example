# ============================================================
# SwipeJob — Variables d'environnement (exemple)
# Copier ce fichier en .env.local et remplir les valeurs réelles
# NE PAS committer .env.local dans le dépôt
# ============================================================

# DATABASE_URL=postgresql://...  # Neon Postgres EU (Story 1.2 — TECH-002)
# REDIS_URL=redis://...          # Upstash Redis / Redis Cloud (Story 1.2 — TECH-005)

# MISTRAL_API_KEY=...            # Mistral AI — Matching IA (Story 2.8 — TECH-004)
# ANTHROPIC_API_KEY=...          # Anthropic Claude — LLM fallback (Story 2.8 — TECH-004)

# SITE_URL=http://localhost:3000      # URL publique de l'app (metadataBase, SEO, OpenGraph)
# NEXTAUTH_SECRET=...            # Auth.js v5 secret (Story 1.3 — TECH-003)
# NEXTAUTH_URL=http://localhost:3000  # URL Auth.js (callback URLs OAuth)

# RESEND_API_KEY=...             # Resend — email transactionnel (Story 1.4)

# R2_ACCOUNT_ID=...              # Cloudflare R2 — stockage CV/docs (Story 1.6 — TECH-006)
# R2_ACCESS_KEY_ID=...           # Cloudflare R2 access key
# R2_SECRET_ACCESS_KEY=...       # Cloudflare R2 secret
# R2_BUCKET_NAME=swipejob-dev    # Nom du bucket R2

# SENTRY_DSN=...                 # Sentry — monitoring erreurs (Story 1.2 — TECH-009)
# POSTHOG_KEY=...                # PostHog — analytics produit (Story 1.2)
# AXIOM_TOKEN=...                # Axiom — logs centralisés (Story 1.2 — TECH-008)

# WORKER_PORT=4000               # Port HTTP du worker Hono (défaut : 4000)
# LOG_LEVEL=info                 # Niveau de log Pino : trace|debug|info|warn|error
